index 309b92e..85012d0 100644
--- a/sys/audio_out.sv
+++ b/sys/audio_out.sv
@@ -50,6 +50,9 @@ module audio_out
 	input [15:0] alsa_l,
 	input [15:0] alsa_r,
 
+	output reg capture_valid = 0,
+	output wire [31:0] capture_sample,
+
 	// I2S
 	output       i2s_bclk,
 	output       i2s_lrclk,
@@ -276,6 +279,19 @@ aud_mix_top audmix_r
 	.out(ar)
 );
 
+// The serial prototype captures the final left channel, after mix/filter/volume.
+// At96kHz output, retain every other sample for a48kHz stereo stream.
+assign capture_sample = {ar,al};
+reg capture_half = 0;
+always @(posedge clk) begin
+    capture_valid <= 0;
+    if(reset) capture_half <= 0;
+    else if(sample_ce) begin
+        capture_half <= ~capture_half;
+        capture_valid <= !sample_rate || !capture_half;
+    end
+end
+
 endmodule
 
 module aud_mix_top
